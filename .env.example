# App
APP_ENV=development
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:5173

# Database (secrets — copy to .env and set real values; never commit .env)
POSTGRES_USER=optistock
POSTGRES_PASSWORD=change-me-before-starting
POSTGRES_DB=optistock
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional override. If unset, the API builds the URL from POSTGRES_* above.
# DATABASE_URL=

MIGRATIONS_PATH=migrations

# JWT (RS256) — generate keys with scripts/generate-jwt-keys.ps1
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
