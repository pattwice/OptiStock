# Production environment — copy to .env.prod and set real secrets before deploy.
# Never commit .env.prod to git.

APP_ENV=production
APP_VERSION=1.0.0
HTTP_PORT=8080
CORS_ORIGINS=

POSTGRES_USER=optistock
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=optistock
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MIGRATIONS_PATH=/migrations

JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Optional S3-compatible storage (MinIO, AWS S3, etc.)
S3_UPLOAD_ENABLED=false
S3_ENDPOINT=http://minio:9000
S3_BUCKET=optistock
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
